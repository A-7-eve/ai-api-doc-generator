# ==========================================================
# AI辅助接口文档自动生成系统 - Docker Compose 环境变量示例
# 复制为 .env 并修改后使用：cp .env.example .env
# 注意：根目录 .env 已被 .gitignore 排除，不会提交到仓库
# ==========================================================

# MySQL 配置（root 密码与库名）
APIDOC_DB_PASSWORD=123456
APIDOC_DB_NAME=apidoc

# 大模型供应商：deepseek（默认）/ teleai（中电信星辰）
LLM_PROVIDER=deepseek

# DeepSeek API Key（LLM_PROVIDER=deepseek 时使用，从 https://platform.deepseek.com 获取）
LLM_API_KEY=

# 中电信星辰大模型 API Key（LLM_PROVIDER=teleai 时使用，从天翼AI开放平台 https://www.teleai.com.cn/ 获取）
TELEAI_API_KEY=